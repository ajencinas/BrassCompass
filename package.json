{
  "name": "the-brass-compass",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tools/test-scripts.mjs && node tools/editor-test.mjs && node tools/playthrough.mjs",
    "gen": "python3 tools/generate.py",
    "test:scripts": "node tools/test-scripts.mjs",
    "typecheck": "tsc --noEmit",
    "test:fast": "tsc --noEmit && node tools/test-scripts.mjs && npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:scale": "node tools/audit_scale.mjs",
    "test:exit": "node tools/exit-audit.mjs",
    "test:connect": "node tools/connect-audit.mjs",
    "test:exitwalk": "node tools/exit-walk-test.mjs",
    "test:exitkeys": "node tools/exit-keyboard-test.mjs",
    "test:all": "npm run test:assets && npm run test:scale && npm run test:exit && npm run test:connect && npm run test:exitwalk && npm run test:exitkeys && npm test && npm run test:fuzz && npm run test:unit && npm run build",
    "test:fuzz": "node tools/fuzz/regression.mjs",
    "to-adv": "node tools/to-adv.mjs",
    "test:editor": "node tools/editor-test.mjs",
    "script:export": "node tools/export-script.mjs",
    "package:itch": "node tools/package-itch.mjs",
    "publish:pages": "node tools/publish-pages.mjs",
    "assets": "node tools/asset-manifest.mjs --write",
    "prebuild": "node tools/asset-manifest.mjs --check",
    "postbuild": "node tools/audit-assets.mjs --dist",
    "test:assets": "node tools/audit-assets.mjs",
    "test:size": "node tools/check-bundle-size.mjs",
    "test:mobile": "node tools/mobile-test.mjs",
    "test:audio": "node tools/audio-test.mjs",
    "test:a11y": "node tools/a11y-test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
