room alley "Chandler's Lane"
  bg bg_alley_wide
  width 2560
  music music_dock
  grade "brightness(0.95) saturate(0.85)"
  perspective horizon 380 ref 875 height 330
  # The chandler's display window sits on the right above the cobbles, so the band drops
  # below it past x 1800.
  walk (470,878) (560,840) (690,790) (730,700) (1800,700) (1900,845) (2430,845) (2520,875)
  entry 2050,862
  arrive dock 2320,862
  arrive chandlery 2050,862
  arrive warehouse 700,815
  arrive counting_house 900,740

  # Atmosphere: wet cobbles, lanterns over the lane and candles in the windows.
  footsteps stone
  light 678,65 radius 110 lantern
  light 860,118 radius 110 lantern
  light 1143,100 radius 110 lantern
  light 1326,45 radius 110 lantern
  light 740,360 radius 60 candle
  light 818,380 radius 60 candle
  light 900,375 radius 60 candle
  light 975,365 radius 60 candle
  light 1048,350 radius 60 candle
  light 1120,318 radius 60 candle
  light 1245,300 radius 60 candle

  sprite npc_silas_body at 1380,806 size 1 flip idle speaker silas for silas grade "saturate(0.85) brightness(0.88)"

  # Act I: Cray steps out to meet Fenn the first time he turns into the lane.
  scene if act 1 and not met_cray_alley and not seen:silas.root
    set met_cray_alley
    say "A man in a good coat steps out of a doorway. He looks like he's been rehearsing this."
    talk silas

  # The crowbar has just been picked up; the shutter is the thing it is for.
  scene if act 1 and has crowbar and not loft_open and not alley_shutter_nudged
    set alley_shutter_nudged
    say "The loft shutter is bolted. The crowbar would fit behind those bolts."

  hotspot silas "man in a good coat"
    show if act 1
    area 1330,515 125x295
    stand 1180,810
    look "Good coat, better boots. He has never carried his own luggage. He's waiting for someone, and he's decided it's me."
    talk "He's already turning to face me. He's been waiting."
      talk silas
    give "He takes only what he's asked for, and he asks for a great deal."
    state if silas_refused = true
      name "Silas Cray"
      look "Silas Cray. He hasn't moved, and he hasn't stopped watching my coat pocket."
      talk "He doesn't turn round. “Still no? Then say it quickly. I bill by the hour.”"
        nothing
    state if silas_offer = true
      name "Silas Cray"
      look "Silas Cray, being patient at me from across the lane."
      talk: talk silas at again
    state if seen:silas.root
      name "Silas Cray"
      talk: talk silas at back

  hotspot chandlery_door "the chandler's"
    area 1900,230 490x500
    stand 2050,862
    exit chandlery
    look "The chandler's window, lit and full of rope. Rope, pitch, canvas. Open late, because ships are always leaving."
    open "I push the door. A bell somewhere in the shop regrets it."

  hotspot warehouse_stairs "bolted shutter"
    # Covers the bolted panel at the top of the stairs, not just the treads: the panel is the
    # thing the look/use lines describe, and it was the part players tried to click.
    area 90,10 440x540
    stand 700,815
    look "A wooden stair up to the harbour loft, shut off by a shutter bolted from this side. Bolts. The eternal enemy of the curious."
    open "Bolted. The shutter has opinions about clerks."
      sound deny
    push "It doesn't move. It has been bolted by a man who meant it."
      sound deny
    use "I need something to lever it. A crowbar would do it."
    pull "Bolted from this side, which is the wrong side for me."
    state if loft_open = true
      name "open loft stairs"
      look "The loft stairs, shutter folded back. The dark up there smells of paper."
    # With the tool in hand, looking at the shutter says what to do with it.
    state if has crowbar
      look "Bolted from this side. The crowbar would fit behind those bolts."
      use "The crowbar fits behind the bolts. One good pull and the shutter is open."
      open "Bolted. The crowbar would fit behind those bolts."
      push "I'm not opening it with my shoulder. The crowbar would do it."

  hotspot loft_stairs_open "open loft stairs"
    show if loft_open = true
    area 90,10 440x540
    stand 700,815
    exit warehouse sound hatch
    look "The stairs up to the loft, shutter folded back. The dark smells of paper."
    open "I go up."

  hotspot to_dock "back to the docks"
    area 2400,320 160x400
    stand 2340,862
    exit dock sound none
    look "The lane runs back down to the waterfront."

  hotspot crates "stacked crates"
    area 20,560 300x210
    nowalk
    look "Crates waiting for the loft, stencilled with a little cloud: Cray & Co. Somebody paid for them and doesn't like being asked what's inside."

  hotspot counting_door "Cray & Co."
    show if act 4
    area 730,300 340x380
    stand 900,730
    exit counting_house
    look "Past where Cray used to wait for me: a brass plate, a polished door, a little cloud. CRAY & CO., FACTORS. There's a light on."
    open "I go up the lane to Cray & Co. The brass plate has been polished so hard it's nearly gone."

  use compass on silas if seen:silas.compass
    "My hand gets as far as my pocket and refuses to come out. Cray watches it with professional interest."
    set silas_refused
  use compass on silas
    "My hand gets as far as my pocket and refuses to come out. Cray watches it with professional interest."
  use crowbar on warehouse_stairs if loft_open
    "The shutter's already folded back, and the bolts are lying in the gutter looking ashamed of themselves."
  use crowbar on warehouse_stairs
    "I get the crowbar behind the shutter and lean. The bolts give one at a time, complaining. They've done this job too long."
    set loft_open
    sound door
