room arcadia_cabin "The Arcadia — Captain's Cabin"
  bg bg_wreckcabin_wide
  width 2560
  music music_fog
  perspective horizon 330 ref 875 height 600
  # The open planking in front of the desk; the ladder's foot and the barrels are not floor.
  walk (100,875) (160,752) (1000,752) (1000,660) (1780,660) (1780,752) (1810,800) (2330,805) (2440,875)
  entry 2000,840

  # Atmosphere: dust in the light through the broken hull, water dripping, timbers creaking.
  footsteps wood
  motes dust (650,0) (1260,0) (1520,860) (620,860) count 60
  emit drip at 520,860
  emit creak

  sprite npc_quill_body at 820,800 size 0.98 idle speaker quill for quill grade "saturate(0.85) brightness(0.9)"

  hotspot windows "the broken planking"
    area 650,0 620x240
    nowalk
    look "Daylight comes through the planks in long gold bars. Dust turns in it."

  hotspot hammock "the hammock"
    area 440,240 840x300
    nowalk
    look "My father's hammock. He always said a bed that doesn't rock is just a shelf with ambitions."
    use "I'd sleep for a week. Quill would let me for about a minute."

  hotspot bucket2 "a bucket"
    area 430,595 170x120
    stand 560,790
    look "A second bucket. My father kept spares of everything except himself."
    pickup "One bucket is a tool. Two is a hobby."

  hotspot bucket "the bucket"
    area 1110,585 140x130
    stand 1180,700
    look "A wooden bucket, iron-hooped. The kind a ship keeps for bailing. It held the sea out of the Arcadia for nine years. Then the sea won."
    pickup "I take the bucket. You never know when you'll need to move a quantity of lagoon."
      give bucket
      set bucket_taken
      sound pickup
    state if bucket_taken
      name "the bucket's mark"
      look "A ring in the salt where the bucket stood. Wrecks remember everything."
      pickup "One bucket is a tool. Two is a hobby."
        nothing

  hotspot pigeonholes "the pigeonholes"
    area 1660,75 320x250
    stand 1760,700
    look "Pigeonholes, stuffed. Charts, receipts, blank Bills of Health. Every captain carries them. Nobody fills one in until a sentry makes him."
    pickup "I take one blank Bill of Health. Old habit: never go anywhere without the right form."
      give bill
      set bill_taken
      sound pickup
    open "Every drawer is full of my father's handwriting. Mostly lists. He liked a list."
    state if bill_taken
      look "The rest of my father's paperwork: bills, receipts, a laundry list in a hand I'd know anywhere. The blanks are for ships that aren't coming."
      pickup "I've taken the blank I need. The others can stay with the Arcadia."
        nothing

  hotspot log "the logbook"
    area 1240,340 540x400
    stand 1500,700
    look "My father's log, on his desk, the pen still in the ink. I open it before I've decided to."
      give ansel_log
      set log_read
      talk log
    open "My father's log. I open it before I've decided to."
      give ansel_log
      set log_read
      talk log
    pickup "My father's log. I open it before I've decided to."
      give ansel_log
      set log_read
      talk log
    use "My father's log. I open it before I've decided to."
      give ansel_log
      set log_read
      talk log
    state if log_read
      name "the desk"
      look "Where the log lay there's a clean rectangle in the salt, like a shadow that stayed behind."
        nothing
      open "I've read it. Some of it twice. Some of it not at all, which is why Quill had to."
        nothing
      pickup "The log's in my pocket. It's heavier than a book should be."
        nothing
      use
        nothing

  hotspot portrait "the portrait"
    area 1455,0 170x165
    stand 1540,700
    look "A small portrait, hung crooked. A woman laughing at whoever is painting her. My mother. I'd forgotten she laughed with her whole face."
    talk "I don't say anything out loud. Quill pretends very hard to be interested in the ceiling."
    pickup "It stays where he hung it. He hung it crooked on purpose. She'd have straightened it."
    state if log_read
      name "Lise Fenn"
      look "Lise Fenn, sailmaker. My mother. The L on fifteen flags. She's smiling like she just heard a joke she already knew."

  hotspot ladder "ladder to the deck"
    area 1990,0 420x780
    stand 2000,840
    exit reef_wreck sound hatch
    look "The ladder back up to the tilted deck, and daylight."

  hotspot quill "Quill"
    area 720,360 200x440
    stand 1000,800
    look "Quill keeps to the far end of the cabin, away from the desk. It's the most tactful thing I've seen a pirate do."
    talk "She keeps her voice down, as if the cabin might be asleep."
      talk quill3 at cabin
    give "“Not in here, cargo. Leave his cabin the way he left it. Mostly.”"
    state if log_read
      talk: talk quill3 at shaken

  use ansel_log on portrait
    "I hold the log up to her. It seems only fair she sees what he wrote. She goes on laughing."
  use crowbar on pigeonholes
    "It's a wreck, not a safe. Everything in here is already open."
  combos quill_combos
