room chandlery "The Chandler's"
  bg bg_chandlery_wide
  width 2560
  music music_office
  grade "brightness(0.95) saturate(0.85)"
  perspective horizon 200 ref 875 height 430
  # The counter is painted at the back plane; a person standing a step in front of it came up
  # to the countertop at the collar. The curve is sized for the counter and the shop door, and
  # the floor reaches the counter's own plane.
  scale 740 442
  scale 810 470
  scale 875 490
  walk (120,875) (170,834) (900,834) (900,800) (1800,800) (1800,834) (2380,834) (2500,875)
  entry 1500,856
  arrive alley 1600,856

  # The invoices are a painted prop, not just a line of text: the player can see the spike.
  sprite prop_invoices at 1480,602 size 0.38 for invoices

  # Atmosphere: the one lantern the chandler can afford.
  footsteps wood
  light 1232,468 radius 380 lantern

  # The spike of invoices the counter text talks about, painted and placed on the counter. Put it
  # before the counter so a click on the papers hits the papers, not the whole counter.
  scene if act 1 and has stamp and not has manifest and not chandlery_invoices_nudged
    set chandlery_invoices_nudged
    say "The spike of invoices is on the counter. One stamp on the oldest and Tallow would owe me the manifest."

  hotspot invoices "spike of invoices"
    area 1395,450 240x140
    stand 1300,800
    look "Three years of unpaid invoices on a spike. The oldest is older than my desk."
    open "The spike is the filing system. Tallow would say it's alphabetical."
    use "One harbour stamp on the oldest invoice and Tallow would owe me a favour."
    state if act 4
      look "The invoice spike, every page stamped PAID. Tallow has framed the first one."
    state if chandler_paid = true
      look "The spike, lighter by one invoice. The rest are still waiting to be paid."

  hotspot counter "the counter"
    area 900,520 900x200
    stand 1350,800
    look "A long counter with a brass scale, a pot of tallow, and a spike of invoices no one has cleared since last century."
    open "The invoices are spiked, not filed. It amounts to the same thing at sea."
    use "Unpaid invoices, waiting for a harbour stamp. I could stamp one of these."
    state if act 4
      look "The counter. Every invoice on the spike is stamped PAID now. Mr Tallow has framed the first one and hung it over the till."
    state if chandler_paid = true
      name "the counter"
      look "The counter, lighter by one unpaid invoice. The chandler will sleep better."

  hotspot shelves "the shelves"
    area 300,120 400x470
    nowalk
    look "Coils of rope, bolts of sailcloth, a lantern for every weather, and one shelf of things that look like they were invented on a dare."
    use "Sailcloth. My mother sewed it for a living. She could tell good canvas from bad by the sound it made tearing. I can't."

  hotspot back_room "back room"
    area 2390,60 170x520
    stand 2300,856
    thing
    look "A dark doorway to the back room. Somebody in there is counting something, out loud, and losing."
    talk "I call into the back room."
      talk tallow
    open "I'm not barging into a man's back room. That's how you meet his cat."
    state if act 4
      look "The back room is dark. A note on the door, in Mr Tallow's harassed capitals: GONE TO THE KEEL. CAT ALREADY THERE."
      talk "Nobody answers. Mr Tallow has gone to the Keel, where the cat has been in charge since supper."
        nothing
      open "It's his back room. Even with the cat out, I'm not that sort of clerk."

  hotspot door_out "door to the lane"
    area 20,260 120x480
    stand 240,856
    exit alley
    look "The lane, wet and honest."

  use stamp on invoices if act 4
    "Everything's paid. Stamping it again would just be showing off, and Mr Tallow isn't here to see."
  use stamp on invoices if chandler_paid
    "One invoice paid is a kindness. Two is a precedent, and Mr Tallow would never stop sending them."
  use stamp on invoices
    "I stamp the oldest invoice PAID. “Anything you like, clerk!” The Arcadia's manifest comes out of the back room. The cat follows."
    give manifest
    set chandler_paid

  use stamp on counter if act 4
    "Everything's paid. Stamping it again would just be showing off, and Mr Tallow isn't here to see."
  use stamp on counter if chandler_paid
    "One invoice paid is a kindness. Two is a precedent, and Mr Tallow would never stop sending them."
  use stamp on counter
    "I stamp the oldest invoice PAID. “Anything you like, clerk!” The Arcadia's manifest comes out of the back room. The cat follows."
    give manifest
    set chandler_paid
