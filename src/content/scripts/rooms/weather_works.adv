room weather_works "Gullet Key — the Weather Works"
  bg bg_works_wide
  width 2560
  music music_fog
  ambience wind
  perspective horizon 380 ref 875 height 300
  walk (60,878) (90,800) (2420,800) (2480,878)
  entry 260,840

  sprite npc_quill_body at 2060,835 size 0.98 flip idle speaker quill for quill grade "saturate(0.8) brightness(0.8) sepia(0.15)"

  hotspot smoke "the smoke"
    area 0,0 2560x240
    nowalk
    look "Smoke, rolling up off the braziers and leaning out over the reef, white as cotton. From the sea it would look like weather. That's the whole trick, in one sentence."
    talk "I cough at it. It coughs back, roughly twice as much of it."

  hotspot kelp "kelp bales"
    area 2280,310 280x430
    stand 2300,820
    look "Bales of dried kelp, bricked and stamped with a little cloud. The same bricks that were in the Marrow's crates. Vane has been shipping the fog. She won't like that."
    pickup "It's evidence, and it's also very itchy. I make a note instead."

  hotspot braziers "the braziers"
    area 140,400 780x350
    stand 600,820
    look "A row of iron braziers, fed kelp a forkful at a time. Each one smokes. None of them is doing the heavy lifting."
    use "I'd only be adding to it. These are the chorus."
    turnoff "There are a dozen of them. I'd want the one that matters."

  hotspot bellows "the bellows"
    area 820,550 230x240
    stand 940,820
    look "Bellows the size of a cow, for when the fog needs encouraging. Somebody's carved WEATHER into the handle, and then a little cloud, and then a smiling face, which is worse."
    push "The great brazier roars. Quill looks at me. I stop."
    use "The great brazier roars. Quill looks at me. I stop."

  hotspot great_brazier "the great brazier"
    area 1120,260 480x480
    stand 1360,820
    look "The great brazier: twice the size of the others and roaring, with the gantry built over it to feed it. This is where the fog comes from. The rest is decoration."
    use "Not with my hands. I'm fond of them, and Quill says she's getting used to them."
    turnoff "There's no lid and no switch. There's a lagoon, though, and lagoons are famously wet."
    pickup "Absolutely not."
    state if fog_down
      name "the dead brazier"
      look "Dead and hissing. Somewhere, Cray's accountant feels a chill."
        talk halyard at grab

  hotspot halyard "the gantry halyard"
    area 1320,0 90x250
    stand 1440,820
    look "A halyard off the gantry, thick as my wrist, running up to a block over the great brazier. Quill keeps looking at it the way she looks at rigging: like a road."
    use "Not yet. Quill says you don't jump until there's something to jump away from."
    pull "It takes my weight without noticing. Good to know. I don't know why it's good to know."
    state if fog_down
      use "Quill already has it."
        talk halyard at grab
      pull: talk halyard at grab
      walk: talk halyard at grab

  hotspot far_side "the far side"
    area 1800,240 460x300
    nowalk
    look "Past the fires, another stretch of palisade, and the glare of the salt camp. The only way over is through the braziers, and I've been asked not to."
    open "Through the fire? Quill says she'd carry me. I believe her, which is the problem."
    state if fog_down
      exit salt_camp
      open "We go over on the halyard."

  hotspot to_gate "the gate"
    area 0,240 140x560
    stand 180,845
    exit key_gate
    look "The gate back out to Pike, who is probably still dabbing at his eyes."
    state if fog_down
      open "Two Weather men are between me and the gate, wiping their feet at me."
        nothing
      use
        nothing
      walk
        nothing

  hotspot quill "Quill"
    show if not fog_down
    area 1975,550 170x290
    stand 1900,840
    look "Quill, with her neckerchief over her mouth, eyeing the gantry and the halyard and the long drop. She looks happy. It's unnerving."
    talk "She pulls her neckerchief down just far enough to be rude to me."
      talk quill3 at works
    give "“Not now. My hands are for halyards.”"
    states none

  use bucket_water on great_brazier if not fog_down
    "I swing the whole bucket."
    take bucket_water
    set fog_down
    sound door
    talk halyard
  use bucket on great_brazier
    "An empty bucket. The brazier isn't frightened of an empty bucket. Nobody is."
  use bucket_water on braziers
    "One small brazier out of a dozen. The fog would barely notice. The big one, in the middle."
  use bill on great_brazier
    "That's not fumigating, that's cremating."
  use bill on braziers if not bill_smoked
    "I hold the bill in the kelp smoke until its corners curl. Fumigated, at the source."
    set bill_smoked
  use bill on braziers
    "It's been fumigated. Any more smoke and it'll start forecasting."
  use crowbar on great_brazier
    "I could poke it. It would poke back."
  combos quill_combos
