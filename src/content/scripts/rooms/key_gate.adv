room key_gate "Gullet Key — the Quarantine Gate"
  bg bg_gate_wide
  width 2560
  music music_office
  perspective horizon 400 ref 875 height 290
  # A strip of sand along the palisade; it steps forward round the fumigation brazier.
  walk (60,878) (80,818) (1620,818) (1640,856) (1880,856) (1900,818) (2480,818) (2500,878)
  entry 300,850
  arrive lagoon_shore 200,850
  arrive weather_works 1310,840

  sprite npc_pike_body at 980,836 size 0.97 idle speaker pike for pike grade "saturate(0.45) brightness(0.95)"
  sprite npc_quill_body at 2080,840 size 0.98 flip idle speaker quill for quill grade "saturate(0.88) brightness(0.95)" if not fog_down

  # The fumigation brazier stands on the sand; walk round in front of it.
  occluder floor 850 (1680,715) (1840,715) (1830,850) (1690,850)

  hotspot yellow_flag "the yellow flag"
    area 1290,0 220x120
    nowalk
    look "A yellow quarantine flag. Under international custom it means “keep away, we are sick.” Under Cray it means “keep away, we are busy.”"

  hotspot hut "the sentry hut"
    area 360,360 470x450
    stand 600,840
    look "Pike's sentry hut: a desk, a stool, a calendar, and a sign reading ALL VISITORS MUST BE INSPECTED, which somebody has dusted this morning."
    open "It's open. It's always open. Pike can see it from where he stands, which he mentions."

  hotspot calendar "the station calendar"
    show if not has calendar_leaf and not bill_dated
    area 545,535 110x100
    stand 600,840
    look "GULLET KEY QUARANTINE STATION, one day per page. Every day so far this year has been torn off neatly and, I'd bet money, filed."
    pickup "Pike's eyes are on me and on his calendar at the same time, which shouldn't be possible. “Station property, sir.”"
    state if pike_reading
      pickup "I tear off today. Pike reaches “six, k: in the event of there being no day” and opens his eyes. I'm admiring the palisade."
        give calendar_leaf
        set pike_reading = false
        sound pickup

  hotspot gate "the gate"
    area 1050,240 530x580
    stand 1310,840
    look "A double gate in the palisade, barred, chained and, by the look of it, inspected. Beyond it something is burning on purpose."
    open "Pike clears his throat. “Bill of Health first, sir. Fumigated, stamped, countersigned and dated.”"
    push "Pike clears his throat at a volume I'd thought only Bramwick could manage."
    pull "Pike clears his throat at a volume I'd thought only Bramwick could manage."
    state if fog_down
      look "Barred again, from inside. Behind it, the Weather are holding a polite meeting about who let the weather out."
      open "Barred. Somebody on the other side says “Sorry!” in a tone that isn't."
        nothing
      use
        nothing
      walk
        nothing
    state if gate_open
      name "the open gate"
      exit weather_works
      look "The gate, open, on a yard full of smoke and iron. Pike holds it for me as if it were a door to a ballroom."
      open "Through the gate, into the smoke."

  hotspot brazier "the fumigation brazier"
    area 1670,600 190x250
    stand 1760,868
    look "A little iron brazier with a sign: FUMIGATION, PAPERS ONLY. It smoulders kelp, politely, in a thin grey curl."
    use "I warm my hands. Pike watches to make sure I'm not fumigating them without a bill."
    pickup "It's hot, it's iron, and it's official. Three reasons to leave it alone."
    turnoff "Pike would put me out for that, and he'd have a form for it."

  hotspot to_shore "path to the lagoon"
    area 0,380 300x420
    stand 200,850
    exit lagoon_shore
    look "The path back down through the dunes to the lagoon and the boat."

  hotspot pike "Pike"
    show if not fog_down
    area 900,560 170x280
    stand 1120,850
    look "A sentry of about nineteen, with a yellow armband big enough to signal ships and a clipboard he holds like a shield. He has the face of a boy who has never once been allowed to stamp anything."
    talk "He snaps to attention so hard his cap goes on without him."
      talk pike
    give "“I can only accept completed paperwork, sir.”"
    state if pike_reading
      talk "He holds up one finger without opening his eyes. “Six, f. Nearly there, sir.”"
        nothing
    state if gate_open
      talk: talk pike at open
    state if seen:pike.halt
      talk: talk pike at again

  hotspot quill "Quill"
    show if not fog_down
    area 2000,550 170x290
    stand 1950,845
    look "Quill, leaning on the palisade with her arms folded, enjoying this enormously."
    talk "She's already looking at me. She's been looking at me since the boat."
      talk quill3 at gate
    give "“Keep it, cargo. You're the one with pockets.”"
    states none

  use bill on brazier if not bill_smoked
    "I hold the bill in the smoke till its corners curl. Fumigated. It smells of a bonfire that has opinions."
    set bill_smoked
    sound chime
  use bill on brazier
    "Any more fumigation and it'll be a kipper."
  use bucket_water on brazier
    "Put out Pike's brazier and he'll fumigate me instead. Besides, the fog isn't coming from anything this small."
  use calendar_leaf on pike
    "“That's a day, sir. A day goes on a bill. I can't accept a loose day.”"
  # The Bill of Health: complete, it opens the gate; otherwise Pike names the first thing missing.
  use bill on pike if gate_open
    "He reads it again anyway, lips moving. “Still beautiful, sir.”"
  use bill on pike if bill_smoked and bill_stamped and bill_signed and bill_dated
    "I hand Pike the Bill of Health. He takes it in both hands, the way you'd take a baby that's been described to you."
    set gate_open
    sound chime
    talk pike at passed
  use bill on pike if not bill_smoked
    "Pike sniffs it. “Not fumigated, sir. It smells of cupboard. Brazier's just there: regulation three.”"
  use bill on pike if not bill_stamped
    "“No harbour stamp, sir. Without a stamp it isn't a bill. It's a letter. A very confident letter.”"
  use bill on pike if not bill_signed
    "“Not countersigned. It wants a ship's officer, sir: captain, mate, bosun, navigator…” His eyes slide to Quill and away, very professionally."
  use bill on pike if not bill_dated
    "He reaches the bottom and his face falls, gently, like a man whose heart has been broken this exact way before. “Not dated, sir.”"
  use stamp on pike
    "He holds out his hand to be stamped, hopefully. I'm tempted. I'm a professional."
  combos quill_combos
  use crowbar on gate if not gate_open
    "I size up the chain with the crowbar. Pike sizes me up with the clipboard. “Regulation one, sir: nobody forces the gate. Regulation two: see regulation one.”"
  use crowbar on gate
    "It's open. Pike would only want a form for opening it any further."
  use bill on calendar
    "I hold the bill up to the calendar in case the date jumps across. Pike watches with real interest. It doesn't. Dates on this island have to be torn off and carried, like everything else."
  use ansel_log on pike
    "Pike reads a line, lips moving, and goes pink to the ears. “That's a captain's log, sir. I'm not cleared for feelings.”"
