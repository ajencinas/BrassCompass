room marrow_cabin "The Marrow — Captain's Cabin"
  bg bg_cabin_wide
  width 2560
  music music_office
  grade "saturate(0.85) brightness(0.9)"
  perspective horizon 200 ref 875 height 430
  # The painted floor is one deep plank run with the chart table in the middle; the measured
  # scale curve was making a foreground figure nearly 640px tall, so the room uses the
  # perspective fit (430 at the near edge) and keeps the cast inside the furniture's size.
  walk (80,875) (140,700) (1800,700) (1840,820) (2380,820) (2420,875)
  entry 2390,860
  arrive marrow_quarterdeck 2390,860
  arrive marrow_gallery 2100,845
  # The chart table is the biggest painted object in the room; whoever walks behind it is
  # hidden by its front apron instead of standing on top of the chart.
  occluder floor 760 (770,600) (1760,548) (1760,760) (770,760)
  footsteps deck
  light 1160,45 radius 200 lantern
  water (1915,240) (2325,240) (2325,690) (1915,690) ripple 1.5
  emit creak

  # Act II: Vex's cabin is optional. The chart, the tidy ledger and the novel
  # under the pillow do the talking while he is up at the helm.
  scene if act 2 and fog_tried and not gallery_hinted
    set gallery_hinted
    say "The stern window is unlatched. The gallery is empty, and every lantern on it is lit."

  scene if act 2 and not vex_exposed
    say "Vex's cabin. The chart is out, the lamp is lit, and nobody is here to stop me."

  hotspot chart "the chart table"
    area 940,310 800x260
    stand 1760,805
    look "Vex's chart of the Shroud. The edge is drawn in a careful hand, and the wrecks are marked in pencil."
    use "A salvage list, tucked under the chart's edge. Ships, dates, cargo, prices. Neat as a shopman's book."
    open "The chart is pinned at the corners. Vex does not like it moved."

  hotspot shelf "the instrument shelf"
    area 620,0 380x340
    nowalk
    look "A shelf of brass instruments, polished every morning. A telescope, dividers, and one thing that does nothing but look expensive."
    use "I do not touch another captain's instruments. That is how expensive things get broken."

  hotspot bunk "the bunk"
    area 0,180 360x540
    nowalk
    look "A bunk made with naval precision. Under the pillow, a novel called Vengeance, face down. The cover has a lady and a sword."

  hotspot windows "the stern windows"
    area 1010,20 720x290
    nowalk
    look "The wake, going back to a harbour I cannot see. Every reason I took this berth is in that white water."

  hotspot gallery "out to the stern gallery"
    area 1900,30 480x660
    stand 2100,845
    look "Beyond the stern window, the captain's gallery, over the wake. Vex's. Nobody goes out uninvited."
    walk "Without an invitation, I would only be a clerk on a balcony, being looked at."
    open "Without an invitation, I would only be a clerk on a balcony, being looked at."
    state if act 2 and fog_tried
      exit marrow_gallery
      look "The gallery, and nobody on it. Vex is at the wheel; the invitation is the empty rail."
      walk "Out onto the gallery, while the captain is busy."

  hotspot door_out "the door to the helm"
    area 2430,140 130x620
    stand 2390,860
    exit marrow_quarterdeck
    look "The door back out to the quarterdeck."

  use compass on chart
    "The needle points past the edge Vex has drawn. It has no opinion about the pencil."
  use spyglass on windows
    "The wake, closer. It is still going the wrong way."
