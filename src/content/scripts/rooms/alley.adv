room alley "Wreckers' Lane"
  bg bg_alley_wide
  width 2560
  music music_dock
  grade "brightness(0.95) saturate(0.85)"
  perspective horizon 380 ref 875 height 330
  walk (470,878) (560,840) (690,790) (730,700) (1800,700) (1900,845) (2430,845) (2520,875)
  entry 2050,862
  arrive dock 2320,862
  arrive chandlery 1900,858
  arrive warehouse 700,815
  arrive counting_house 1200,745
  footsteps stone
  light 678,65 radius 110 lantern
  light 860,118 radius 110 lantern
  light 1143,100 radius 110 lantern
  light 1326,45 radius 110 lantern
  light 740,360 radius 60 candle
  light 818,380 radius 60 candle
  light 900,375 radius 60 candle
  light 975,365 radius 60 candle
  light 1048,350 radius 60 candle
  light 1120,318 radius 60 candle
  light 1245,300 radius 60 candle

  # Act I: the wreckers work the bottom of the lane. Pike keeps the paperwork.
  scene if act 1 and not alley_seen
    set alley_seen
    say "Wreckers' Lane. Every door is shut except one, and the lamps are still lit."
    say "A young man in a grey coat is writing on a clipboard under them."

  # You come in from the docks at the counting-house end, and the boat shed's open door is a
  # full screen up the lane. Say where it is, once.
  scene if not alley_way_out_seen
    set alley_way_out_seen
    say "Up the lane, past Vex's lamps and the shipwright's lit window, the boat shed's latch is up and its door stands open a hand's width."

  sprite npc_pike_body at 1380,806 size 1 flip idle speaker pike for pike grade "saturate(0.85) brightness(0.88)"

  hotspot pike "Pike"
    area 1330,515 125x295
    stand 1180,810
    look "Pike. Grey coat, yellow armband, and a clipboard he holds like a shield."
    talk "He lowers the clipboard a little."
      talk pike
    give "He writes something down instead of taking it."
    state if rudder_back
      name "Pike"
      look "Pike. The clipboard is under his arm now. He looks like a man who has just been audited."
      talk: talk pike at after

  hotspot shed "the wreckers' shed"
    area (20,470) (630,470) (640,800) (20,800)
    stand 560,840
    look "A lean-to under the stairs, packed with crates of ships' stores."
      say "Somebody has scraped the shipping marks off."
      set saw_stores
    open "The lean-to is tied shut with a length of chain. The chain is loose enough to be a suggestion."
    push "The chain rattles, and Pike's pencil stops moving."
    state if rudder_back
      name "the picked-over shed"
      look "The lean-to is tidier than it was. The chain is down, and the best crates have gone."

  # The left building is the boat shed: its tall ground-floor openings, corner lit, run from
  # the first-floor band down to the cobbles. The stand is on the lane at its foot.
  hotspot boat_shed "the boat shed door"
    area 580,300 120x400
    stand 660,828
    exit warehouse
    look "The boat shed. The latch is up, and the door is open a hand's width. Somebody is inside."
    open "I push the door. It gives quietly, as if it has been opened carefully before."
    state if dorrit_cleared
      look "The boat shed. The door is shut now, and the latch is down."
      open "The shed is quiet. Dorrit has packed his spoons."

  # Vex's front is the near pair of the terrace doors, glazed over panelled bottoms, at the
  # point where the lane's paving is widest in front of them.
  hotspot counting_door "the counting house door"
    area 1045,425 200x250
    stand 1130,745
    exit counting_house
    look "A warehouse door with a lamp above it. The paint is newer than the rest of the lane. Vex's counting house."
    open "I go up the lane to Vex's warehouse."

  # The shop's own glazed door, with its brass handle: the pane beside the big rope window,
  # not the window itself.
  hotspot chandlery_door "the shipwright's door"
    area 1700,190 165x510
    stand 1790,858
    exit chandlery
    look "The shipwright's window, lit and full of rope. Open late, because ships are always leaving."
    open "I push the door. A bell somewhere in the shop regrets it."

  # The lane turns out of frame at the bottom right, past the shop's corner: the painted
  # paving is the way back, not the shop's side wall.
  hotspot to_dock "the lane back down to the docks"
    area 2300,775 260x105
    stand 2340,858
    exit dock sound none
    look "The lane runs back down to the waterfront."
