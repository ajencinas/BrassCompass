room dock "Dreadwater Harbour"
  bg bg_dock_v2_wide
  width 2560
  music music_dock
  grade "brightness(0.95) saturate(0.85)"
  ambience gulls
  # The strict side-on close-up of the harbour area view: the Marrow's dark bow and rigging at
  # the left, the harbourmaster's jettied house with its lit plank door at the centre, the
  # counting house's green lamp at the right, and the wet board-and-stone quay running on past
  # it to the signpost and the harbour-mouth steps at the far right.
  perspective horizon 470 ref 875 height 330
  # One continuous painted path across the lower third: stone flags at the left, wet boards and
  # cobbles under the house, the worn steps at the right. Every stand and arrival sits on it;
  # the crates and barrels stay against the walls, above it.
  walk (860,878) (860,834) (900,810) (960,792) (1020,776) (1100,758) (1200,735) (1350,720) (1500,707) (1650,700) (1800,697) (1950,696) (2050,702) (2150,712) (2250,728) (2350,748) (2450,780) (2500,820) (2500,878)
  entry 1180,800
  arrive tavern 900,815
  arrive office 1280,790
  arrive alley 1470,790
  arrive village 2380,830
  arrive pier_end 1150,800
  arrive quay 1950,790
  footsteps stone
  # Painted lights, each on its flame or glass: the counting house's green lamp, the tall quay
  # lamp, the hanging iron lantern on its gib, and the warm lamp over the harbourmaster's door.
  # The Salty Keel's little window is the other warm light on this stretch of quay.
  light 1692,320 radius 90 lantern colour "#79e6a4"
  light 1975,345 radius 130 lantern
  light 1878,365 radius 65 lantern
  light 1250,540 radius 90 lantern
  light 928,515 radius 70 lantern
  # The harbour water under the Marrow's bow, kept clear of her hull and the jetty boards.
  water (0,685) (260,690) (430,715) (480,745) (430,770) (0,770) ripple 1.6
  emit lapping at 300,730
  # The crate stacks against the house wall are solid: whoever stands behind them is repainted
  # over. The path is in front of their floor line, so Fenn walking past is never covered.
  occluder floor 690 (700,520) (1060,520) (1060,690) (700,690)

  # Act I: the boat from the mainland puts Fenn ashore. The harbour is half empty;
  # the only ship with her gear aloft is the Marrow.
  scene if act 1 and not dock_landed
    set dock_landed
    say "The boatman puts me on the pier and pushes off before I can thank him."
    say "Dreadwater. Three months since my father sailed, and the harbour has gone quiet."
    say "One ship is tied up. The other berths are empty, and the lamps are lit for nobody."
    say "A lamp burns in the harbourmaster's house. It is the only welcome in sight."
    say "The quay runs on past the harbourmaster's house, out toward the harbour mouth."

  # The painted signpost on the path at the counting house corner: its arrow points on along
  # the quay to the harbour-mouth steps. It belongs to the pier hotspot, so it leaves with it.
  sprite prop_quay_sign at 1880,830 size 0.68 for pier

  hotspot ship "the Marrow"
    area (0,120) (620,120) (660,560) (600,680) (0,680)
    stand 760,845
    look "The Marrow. Her sails are still bent, and her deck is scrubbed. She is the only ship here with any gear aloft."
    talk "I call up to the deck. Nobody answers. The harbour has taught everyone not to shout at ships."
    open "I am not opening a ship. Ships open themselves, usually at the worst moment."
    pickup "She is a little big for my satchel."
    use "I would need a captain first. That seems to be the trouble everywhere on this island."
    state if vex_deal
      look "The Marrow. A new rudder is lashed by her rail, and somebody has been painting her name."
      talk "A man on deck raises a hand, then remembers he is not supposed to be friendly."
    state if met_vex
      name "the Marrow, Vex's ship"
      look "The Marrow. Vex's ship, and the only way off this island that is still afloat."

  # The low warm frontage under the jettied house, beside the harbourmaster's door: the
  # Salty Keel, its little window lit over the stacked crates.
  hotspot tavern_door "the Salty Keel"
    area 820,400 200x250
    stand 900,815
    exit tavern
    look "The Salty Keel. Warm light, and the sound of people carefully not saying something."
    open "I push the door. The room goes quiet in the way a room does when it knows me."

  hotspot office_door "the harbourmaster's house"
    area 1180,450 140x200
    stand 1280,790
    exit office
    look "The harbourmaster's house. A lamp is burning behind the glass."
    open "I go in. Bramwick has run this harbour for thirty years, and he will know what to say."

  # The shadowed slot between the house's corner post and the counting house wall: the mouth
  # of Wreckers' Lane, with the crates stacked against it.
  hotspot alley_mouth "Wreckers' Lane"
    area 1360,300 100x320
    stand 1470,790
    exit alley sound none
    look "A gap between two warehouses. Wreckers' Lane. The name is doing a lot of work."
    open "I turn into the lane. It smells of tar and wet rope."

  # The lane runs on out of the frame at the far right, climbing between the counting house
  # and the tall timber house below Upper Town.
  hotspot road "the road up to town"
    area 2340,600 210x260
    stand 2400,835
    exit village sound none
    look "The road climbs between the warehouses to Upper Town. Every shutter up there is shut."
    open "I take the road up. The cobbles are wet, and the town is listening."

  # The painted path itself, running on past the counting house to the signpost, the lamp and
  # the short flight of stone steps at the far right.
  hotspot pier "the quay to the harbour mouth"
    area (1830,580) (2320,580) (2320,830) (1830,830)
    stand 2130,790
    exit quay sound none
    look "The boardwalk runs on past the harbourmaster's house. Past it is the quay, then the pier, then the harbour mouth."
    open "I walk on along the quay, out toward the harbour mouth."

  hotspot water "the harbour water"
    area (0,685) (260,690) (430,715) (480,745) (430,770) (0,770)
    nowalk
    look "Black water. Past the headland, the fog has sat for three months without moving."
      say "Six ships used to tie up here. Now there is one."
    talk "I say my father's name to the water. The water has heard it before."
    use "I could drink it. I have had worse from the tavern."
