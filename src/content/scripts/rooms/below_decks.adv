room below_decks "The Marrow — Below Decks"
  bg bg_below_wide
  width 2560
  music music_office
  perspective horizon 470 ref 875 height 560
  # The plank floor in front of the sea-chest, the mess table and the galley stove.
  walk (60,875) (120,845) (700,845) (760,808) (1180,808) (1200,815) (1440,815) (1480,770) (1580,770) (1600,850) (2060,865) (2100,875)
  entry 1800,868

  # Hobb stands behind Pell's chest until the gong; the chest hides his legs.
  sprite npc_hobb_body at 520,740 size 1.12 visible 0.83 flip idle speaker hobb for hobb grade "saturate(0.85) brightness(0.85)"
  # After the gong, at the mess table, behind it.
  sprite npc_hobb_body at 1080,700 size 1.12 visible 0.83 idle speaker hobb for hobb_table grade "saturate(0.85) brightness(0.85)"
  sprite npc_dorrit_body at 1520,760 size 0.92 flip idle speaker dorrit for dorrit grade "saturate(0.85) brightness(0.88)"

  # Pell's sea-chest.
  occluder floor 832 (300,575) (670,575) (670,835) (300,835)
  # The mess table and its front bench.
  occluder floor 805 (850,580) (1345,580) (1410,640) (1410,810) (850,810)

  hotspot hammocks "hammocks"
    area 0,100 1040x420
    nowalk
    look "Hammocks slung in rows, swaying in time like a congregation. Nobody sleeps in the third one along. Nobody's said why, and I'm not going to ask."
    use "It's mid-morning, and I'd never get out again."

  hotspot window "grating"
    area 1260,370 240x150
    nowalk
    look "Daylight through a grating, in neat squares, like the sea filled in a form."

  hotspot ladder "ladder to the deck"
    area 2020,40 400x800
    stand 1990,865
    exit marrow_deck
    look "The ladder up to the main deck, and daylight."

  hotspot table "mess table"
    area 850,580 560x220
    stand 1100,810
    look "The mess table, scrubbed pale and scored with thirty years of knives and opinions."
    use "I'd sit, but there's nothing to eat yet, and the bench looks like it bites."

  hotspot stove "galley stove"
    area 1600,600 400x240
    stand 1700,860
    look "An iron stove that has been lit since Port Vela and has the temper to show for it."
    turnoff "Dorrit would have me in irons. Proper ones, with a receipt."

  hotspot gong "the gong"
    area 1820,0 220x270
    stand 1880,860
    look "A brass gong, polished till it shows me my own face, looking hungry."
    use "Dorrit gives me a look that could pickle an eel. Only the cook strikes the gong."
    push "Dorrit gives me a look that could pickle an eel. Only the cook strikes the gong."

  hotspot stew "stew pot"
    area 1690,455 200x145
    stand 1760,860
    look "A stew pot the size of a font, bubbling away. It smells ready. According to Dorrit it is not ready, because nobody has said so in writing."
    pickup "Dorrit's ladle intercepts my hand. “Uninspected,” he says, gently."
    open "Dorrit puts the lid back on it before I've lifted it an inch."
    state if dinner
      look "The stew, officially passed. It smells better for it. That may be my imagination, or the paperwork."
      pickup "Dorrit is already ladling it out. I'm in the queue, like everyone else."

  hotspot chest "Pell's sea-chest"
    area 300,575 370x260
    stand 720,850
    look "A sea-chest with iron bands and a name burned into the lid: PELL. There is a bosun behind it."
    open "Hobb's hand arrives on the lid a moment before mine does. It stays there."
    pull "Hobb's hand arrives on the lid a moment before mine does. It stays there."
    state if chest_open
      look "Pell's chest, empty now except for a smell of tar and pipe tobacco and forty years."
      open "I've taken what Pell would have wanted taken. The rest is his."
    state if dinner
      look "Pell's sea-chest, iron-banded, and for the first time this morning nobody is standing behind it."
      open "I lift the lid. Inside: a sextant polished to a mirror, and Pell's logbook. The last page is one sentence long, and it doesn't finish."
        give sextant
        give pell_log
        set chest_open
        sound pickup

  hotspot hobb "Hobb"
    show if not dinner
    area 430,380 190x200
    stand 720,850
    look "Hobb, the bosun, with his arms folded across a lifetime of names. He is guarding a chest the way other men guard a grave."
    talk "He looks at me as though I'm a knot somebody tied badly."
      talk hobb
    give "He doesn't unfold his arms. That's the whole answer."

  hotspot hobb_table "Hobb"
    show if dinner
    area 990,380 190x200
    stand 1100,810
    look "Hobb, eating stew with the steady attention of a man who has waited three days for it."
    talk "He puts down his spoon. That's a compliment from Hobb."
      talk hobb at table
    give "“Not money. Don't insult me with money.”"
    state if crew_agree
      talk: talk hobb at fed

  # Posted at the bow for the fog run.
  hotspot dorrit "Dorrit"
    show if not vane_convinced
    area 1440,470 160x290
    stand 1450,815
    look "Dorrit, the cook, in a spotless apron over a customs officer's waistcoat. He holds his ladle the way I hold a pen."
    talk "He straightens his spectacles, which is how he says hello."
      talk dorrit
    give "“Nothing changes hands in my galley without a docket.”"
    state if dinner
      talk: talk dorrit at fed

  use stamp on stew if not dinner
    "I fish out a potato and stamp it. Dorrit takes off his spectacles to look at it properly."
    talk dorrit at passed
  use stamp on stew
    "It's been passed once. Passing it twice would be showing off."
  use stamp on dorrit if not dinner
    "“Not me, clerk. The stew. I have been passed already, many years ago, with reservations.”"
  use manifest on hobb_table if vane_terms
    "I lay the Arcadia's manifest beside his bowl."
    talk hobb at manifest
  use manifest on hobb_table
    "Hobb pushes it back with one finger. “Captain hasn't said south. Till she does, that's just a list.”"
  use manifest on hobb
    "“I don't read on an empty stomach, clerk. Nobody on this ship has eaten since Dorrit lost his stamp.”"
  use crowbar on chest
    "I look at the crowbar, and then at Hobb, and then I put the crowbar away."
